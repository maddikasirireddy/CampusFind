# CampusFind — Environment Variables Template
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your values (get DATABASE_URL and JWT_SECRET from your teammate on WhatsApp)
#   3. NEVER commit .env to GitHub

# Paste your Neon connection string here:
DATABASE_URL=postgresql://your_user:your_password@your_host/neondb?sslmode=require

PORT=3001
NODE_ENV=development

# Same JWT_SECRET for all teammates:
JWT_SECRET=replace_with_the_shared_secret_from_whatsapp
