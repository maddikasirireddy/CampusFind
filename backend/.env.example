# Backend Environment Configuration (.env.example)

# Port for the Express server
PORT=3001

# Node Environment ('development' or 'production')
NODE_ENV=development

# Shared Neon PostgreSQL Cloud Database URL
# Example: postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT Secret (Shared across teammates and deployment)
JWT_SECRET=replace_with_shared_secret
JWT_EXPIRES_IN=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
