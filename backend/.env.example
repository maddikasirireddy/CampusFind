# Backend Environment Configuration (.env.example)

# Port for the Express server (Render sets PORT automatically)
PORT=3001

# Production Node Environment ('development' or 'production')
NODE_ENV=development

# Database Connection (Use DATABASE_URL for hosted providers such as Render PostgreSQL)
# Example: postgresql://username:password@dpg-xxx.oregon-postgres.render.com/campusfind_db
DATABASE_URL=

# Fallback individual database parameters (used if DATABASE_URL is not set)
DB_HOST=/tmp
DB_PORT=5432
DB_USER=sirireddy
DB_PASSWORD=
DB_NAME=campusfind
# DB_SSL=true

# JWT Configuration (MUST be at least 32 characters long in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_32_character_string_for_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin(s) for CORS (comma-separated for multiple origins)
# Example: https://campusfind.vercel.app,https://campusfind-dev.vercel.app
FRONTEND_URL=http://localhost:5173

